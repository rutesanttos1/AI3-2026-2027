{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "disciplina": {
      "type": "string",
      "pattern": "^Aplicacoes .+"
    },
    "codigo": {
      "type": "string",
      "enum": ["12A", "13A", "14A", "34A", "40A"]
    },
    "totalAlunos": {
      "type": "integer",
      "minimum": 16,
      "maximum": 24
    },
    "docenteTeorica": { "$ref": "#/definitions/nomeDocente" },
    "numeroInscritosTp1": { "type": "integer" },
    "docenteTp1": { "$ref": "#/definitions/nomeDocente" },
    "numeroInscritosTp2": { "type": "integer" },
    "docenteTp2": { "$ref": "#/definitions/nomeDocente" },
    "data": {
      "type": "string",
      "enum": ["08-10-2026", "09-10-2026", "18-11-2026"]
    },
    "cursos": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["tdm", "ei", "msti", "rsi"]
      }
    },
    "contacto": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 200000000,
          "maximum": 999999999
        },
        {
          "type": "string",
          "enum": ["naoAplicavel"]
        }
      ]
    },
    "planoAno1": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ADM1", "API1", "BD1"]
          }
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ID1", "SI1", "SD1"]
          }
        }
      ]
    }
  },
  "required": ["disciplina", "codigo", "data"],
  "dependencies": {
    "numeroInscritosTp1": ["docenteTp1"],
    "numeroInscritosTp2": ["docenteTp2"]
  },
  "definitions": {
    "nomeDocente": {
      "type": "string",
      "pattern": "^[A-Z][a-z]+ [A-Z][a-z]+$",
      "minLength": 5,
      "maxLength": 40
    }
  }
}