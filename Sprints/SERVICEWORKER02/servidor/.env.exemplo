
# API05 — Configuração do servidor

# Segredo JWT (mínimo de 32 caracteres).
JWT_SEGREDO=colocar_aqui_um_segredo_com_pelo_menos_32_caracteres

# Simular perda de resposta após criar uma sugestão.
# 0 = desligado; 1 = ligado.
SIMULAR_PERDA_RESPOSTA=0

# Número de pedidos POST que devem receber erro 503.
# 0 = desligado.
SIMULAR_503=0
