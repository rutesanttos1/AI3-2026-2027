<fatura id="1">
    <cabecalho>
        <data>2023-01-01</data>
        <cliente>
            <nome>Nome do Cliente</nome>
            <morada>Rua do Cliente, 123</morada>
            <telefone>123456789</telefone>
        </cliente>    
    </cabecalho>
    <produtos>
        <produto>
            <codigo>1</codigo>
            <designacao>Produto 1</designacao>
            <quantidade>10</quantidade>
            <preco>100.00</preco>
        </produto>
        <produto>
            <codigo>2</codigo>
